<Window x:Class="InfoTransfer.ScheduledTaskConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="定时推送任务"
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40A9FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D9D9D9"/>
                    <Setter Property="Foreground" Value="#999"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#FF4D4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7875"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D9D9D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#52C41A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#73D13D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D9D9D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6F7FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#1890FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部按钮栏 -->
        <Border Grid.Row="0" Background="White" Padding="16">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnAdd" Content="添加任务" Style="{StaticResource PrimaryButton}"
                        Click="BtnAdd_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnEdit" Content="修改" Style="{StaticResource SecondaryButton}"
                        Click="BtnEdit_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="BtnDelete" Content="删除" Style="{StaticResource DangerButton}"
                        Click="BtnDelete_Click" IsEnabled="False"/>
                <TextBlock x:Name="TxtStatus" Text="请选择或添加定时任务" VerticalAlignment="Center"
                           Foreground="#999" FontSize="13" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 中部内容区 -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：任务列表 -->
            <Border Grid.Column="0" Background="White" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="16">
                        <TextBlock Text="定时任务列表" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>

                    <ListBox x:Name="TaskList" Grid.Row="1"
                             ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                             BorderThickness="0" Background="Transparent"
                             SelectionChanged="TaskList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14"/>
                                            <Border x:Name="StatusBadge" CornerRadius="2" Padding="4,2" Margin="8,0,0,0"
                                                    Background="#52C41A">
                                                <TextBlock Text="启用" FontSize="10" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SourceId}" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧：编辑区 -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="任务配置" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtCurrentTask" Text="" FontSize="14" Foreground="#999"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="EditPanel">
                            <!-- Task ID -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Task ID" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="TxtTaskId" MaxLength="50" IsEnabled="False"/>
                                <TextBlock Text="唯一标识任务的ID" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- 名称 -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="任务名称" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="TxtTaskName" MaxLength="100" IsEnabled="False"/>
                                <TextBlock Text="用于显示的任务名称" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- 消息源 -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="消息源" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox x:Name="CmbSource" IsEnabled="False" DisplayMemberPath="DisplayName"/>
                                <TextBlock Text="选择数据来源" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- 消息体（终端） -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="推送终端" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox x:Name="CmbTerminal" IsEnabled="False" DisplayMemberPath="TerminalId"/>
                                <TextBlock Text="选择推送目标终端" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- 推送类型 -->
                            <Border Background="#E6F7FF" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="推送类型" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="ChkEnableText" Content="文字消息" IsEnabled="False" Margin="0,0,24,0"/>
                                        <CheckBox x:Name="ChkEnableImage" Content="图片消息" IsEnabled="False"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 执行时间 -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="执行时间" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBox x:Name="TxtScheduleTimes" Width="200" HorizontalAlignment="Left" IsEnabled="False"
                                         ToolTip="多个时间点用逗号分隔，如 08:00,12:00,20:00"/>
                                <TextBlock Text="多个时间点用逗号分隔，如 08:00,12:00,20:00" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- 上次执行 -->
                            <StackPanel x:Name="LastRunPanel" Margin="0,0,0,16" Visibility="Collapsed">
                                <TextBlock Text="上次执行" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtLastRun" Text="-" FontSize="13" Foreground="#666"/>
                            </StackPanel>

                            <!-- 今日已执行 -->
                            <StackPanel x:Name="TodayExecutedPanel" Margin="0,0,0,16" Visibility="Collapsed">
                                <TextBlock Text="今日已执行" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtTodayExecuted" Text="-" FontSize="13" Foreground="#52C41A"/>
                            </StackPanel>

                            <!-- 启用状态 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <CheckBox x:Name="ChkIsEnabled" Content="启用任务" IsEnabled="False"/>
                            </StackPanel>

                            <!-- 操作按钮 -->
                            <StackPanel x:Name="EditButtonGroup" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="Collapsed">
                                <Button x:Name="BtnSave" Content="保存" Style="{StaticResource SecondaryButton}"
                                        Click="BtnSave_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource PrimaryButton}"
                                        Background="#999" Click="BtnCancel_Click"/>
                            </StackPanel>

                            <!-- 帮助提示 -->
                            <Border Background="#F6FFED" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="提示:" FontWeight="Bold" Foreground="#52C41A"/>
                                    <TextBlock Text="创建定时任务后，系统会自动按设定间隔调用API获取数据并推送" FontSize="12" Foreground="#52C41A" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 空状态提示 -->
                    <TextBlock x:Name="TxtEmptyHint" Grid.Row="1" Text="请从左侧列表选择任务，或点击「添加任务」创建新任务"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#999" FontSize="14"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部按钮栏 -->
        <Border Grid.Row="2" Background="White" Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关闭" Padding="24,10"
                        Background="#F0F0F0" BorderThickness="0" Click="BtnClose_Click" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
