<Window x:Class="InfoTransfer.AccountEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加/编辑账号"
        Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F2F5">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#1890FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40A9FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Account ID" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtAccountId" MaxLength="50"/>
                <TextBlock Text="唯一标识账号的ID" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="名称" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtName" MaxLength="100"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="账号类型" FontWeight="Bold" Margin="0,0,0,8"/>
                <ComboBox x:Name="CmbAccountType">
                    <ComboBoxItem Content="Feishu" IsSelected="True"/>
                    <ComboBoxItem Content="DingTalk"/>
                    <ComboBoxItem Content="WeCom"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="凭证/密钥" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtCredentials" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                <TextBlock Text="飞书机器人 Webhook 地址或其他凭证" FontSize="11" Foreground="#999" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="描述" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtDescription" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Padding="24,10" Margin="0,0,12,0"
                    Background="#F0F0F0" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand"/>
            <Button Content="确定" Style="{StaticResource PrimaryButton}" Click="BtnOK_Click"/>
        </StackPanel>
    </Grid>
</Window>
