<Window x:Class="InfoTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="飞书消息转发服务" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <!-- 样式定义 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40A9FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D9D9D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#52C41A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#73D13D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D9D9D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#FF4D4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7875"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D9D9D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusIndicator" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部控制区 -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 服务控制 -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="服务控制" Style="{StaticResource HeaderText}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnStartServer" Content="启动服务" 
                                Style="{StaticResource SecondaryButton}" 
                                Click="BtnStartServer_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnStopServer" Content="停止服务" 
                                Style="{StaticResource DangerButton}" 
                                Click="BtnStopServer_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>

                <!-- 服务状态 -->
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="运行状态" Style="{StaticResource HeaderText}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusIndicator" Width="12" Height="12" 
                                 Fill="#D9D9D9" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="已停止" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="API服务器: " Foreground="#666"/>
                        <TextBlock x:Name="TxtApiStatus" Text="未运行" Foreground="#999"/>
                        <TextBlock Text=" | 后台扫描: " Foreground="#666" Margin="12,0,0,0"/>
                        <TextBlock x:Name="TxtPushStatus" Text="未运行" Foreground="#999"/>
                    </StackPanel>
                </StackPanel>

                <!-- 统计信息 -->
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="消息统计" Style="{StaticResource HeaderText}"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FFF7E6" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="待处理: " Foreground="#FA8C16"/>
                                <TextBlock x:Name="TxtPendingCount" Text="0" Foreground="#FA8C16" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F6FFED" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="已发送: " Foreground="#52C41A"/>
                                <TextBlock x:Name="TxtSentCount" Text="0" Foreground="#52C41A" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFF1F0" CornerRadius="4" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="失败: " Foreground="#FF4D4F"/>
                                <TextBlock x:Name="TxtFailedCount" Text="0" Foreground="#FF4D4F" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- 功能按钮 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="BtnServerConfig" Content="服务器配置"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnServerConfig_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnFeishuConfig" Content="飞书推送配置"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnFeishuConfig_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnMessageSource" Content="消息源设置"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnMessageSource_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPushConfig" Content="推送设置"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnPushConfig_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnScheduledTask" Content="定时推送"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnScheduledTask_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnGDSignalConfig" Content="配置GD监控"
                            Style="{StaticResource SecondaryButton}"
                            Background="#722ED1"
                            Click="BtnGDSignalConfig_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnGDSignalMonitor" Content="启动GD监控"
                            Style="{StaticResource SecondaryButton}"
                            Background="#FA8C16"
                            Click="BtnGDSignalMonitor_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中部内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：实时消息动态 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="实时消息动态" Style="{StaticResource HeaderText}"/>
                        <TextBlock x:Name="TxtActivityCount" Text="(0)" Foreground="#999" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="ActivityListBox" Grid.Row="1"
                             BorderBrush="#E8E8E8" BorderThickness="1"
                             Background="White" FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 状态标签 -->
                                        <Border Grid.Column="0" Grid.RowSpan="2" CornerRadius="4" Padding="6,4" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFF7E6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Sent">
                                                            <Setter Property="Background" Value="#F6FFED"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Error">
                                                            <Setter Property="Background" Value="#FFF1F0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FA8C16"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Sent">
                                                                <Setter Property="Foreground" Value="#52C41A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Error">
                                                                <Setter Property="Foreground" Value="#FF4D4F"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- 终端和来源 -->
                                        <StackPanel Grid.Column="1" Grid.Row="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="终端: " Foreground="#999"/>
                                                <TextBlock Text="{Binding TerminalId}" FontWeight="Bold" Foreground="#333"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="来源: " Foreground="#999"/>
                                                <Border Background="#E6F7FF" CornerRadius="3" Padding="4,1">
                                                    <TextBlock Text="{Binding SourceId}" Foreground="#1890FF" FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="方式: " Foreground="#999"/>
                                                <Border CornerRadius="3" Padding="4,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F0F5FF"/>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Method}" Foreground="#6666CC" FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 时间 -->
                                        <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding Time}"
                                                   Foreground="#999" FontSize="10" VerticalAlignment="Top"/>

                                        <!-- 消息内容 -->
                                        <TextBlock Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
                                                   Text="{Binding Message}" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧：运行日志 -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="运行日志 (可复制)" Style="{StaticResource HeaderText}"/>
                        <Button Content="清空"
                                Padding="12,4" Background="#F0F0F0" BorderThickness="0"
                                Click="BtnClearLog_Click" Cursor="Hand" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBox x:Name="LogTextBox" Grid.Row="1"
                             BorderBrush="#E8E8E8" BorderThickness="1"
                             Background="White" FontFamily="Consolas" FontSize="11"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="White" Padding="16,8" Margin="8,0,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtLastScan" Text="最后扫描: --" 
                           VerticalAlignment="Center" Foreground="#666"/>
                <TextBlock Grid.Column="1" Text="|" Margin="16,0" Foreground="#D9D9D9"/>
                <TextBlock x:Name="TxtServerUrl" Text="API地址: http://localhost:5000" 
                           VerticalAlignment="Center" Foreground="#666"/>
            </Grid>
        </Border>
    </Grid>
</Window>
