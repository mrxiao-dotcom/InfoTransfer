<Window x:Class="InfoTransfer.GDStockSignalConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="股票GD策略监控配置"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40A9FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#52C41A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#73D13D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#FF4D4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7875"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GrayButton" TargetType="Button">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BFBFBF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid>
                <TextBlock Text="股票GD策略监控配置" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse x:Name="StatusIndicator" Width="12" Height="12" Fill="#D9D9D9" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatus" Text="已停止" VerticalAlignment="Center" Foreground="#666"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 配置内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- API配置 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="API配置" FontSize="15" FontWeight="Bold" Foreground="#333" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API完整地址:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtApiBaseUrl" Grid.Column="1" Style="{StaticResource InputStyle}"/>
                            <TextBlock Grid.Column="2" Text="包含完整路径" Foreground="#999" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API Token:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="TxtApiToken" Grid.Column="1" Style="{StaticResource InputStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 主要监控策略选择 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="主要监控策略" FontSize="15" FontWeight="Bold" Foreground="#333" Margin="0,0,0,12"/>
                        <TextBlock Text="勾选要监控的策略，系统将按规则判断并推送" Foreground="#666" FontSize="12" Margin="0,0,0,12"/>

                        <WrapPanel x:Name="StrategyCheckboxPanel">
                            <CheckBox x:Name="ChkGD15" Content="GD15" Margin="0,0,20,8" FontSize="13"/>
                            <CheckBox x:Name="ChkGD20" Content="GD20" Margin="0,0,20,8" FontSize="13"/>
                            <CheckBox x:Name="ChkGD25" Content="GD25" Margin="0,0,20,8" FontSize="13"/>
                            <CheckBox x:Name="ChkGD30" Content="GD30" Margin="0,0,20,8" FontSize="13"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 监控时间配置 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="监控时间配置" FontSize="15" FontWeight="Bold" Foreground="#333" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="日盘时间段:" Style="{StaticResource LabelStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="TxtDayStartTime" Width="70" Style="{StaticResource InputStyle}" Text="09:30"/>
                                <TextBlock Text=" 至 " VerticalAlignment="Center" Margin="8,0"/>
                                <TextBox x:Name="TxtDayEndTime" Width="70" Style="{StaticResource InputStyle}" Text="15:00"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="监控频率:" Style="{StaticResource LabelStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="RbFixedTime" Content="固定时间点" IsChecked="True" GroupName="MonitorFreq" VerticalAlignment="Center" Margin="0,0,10,0" Checked="RbFixedTime_Checked"/>
                                <TextBox x:Name="TxtFixedTimeMinutes" Width="100" Style="{StaticResource InputStyle}" Text="0,15,30,45" Margin="0,0,10,0"/>
                                <TextBlock Text="分" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <RadioButton x:Name="RbInterval" Content="间隔" GroupName="MonitorFreq" VerticalAlignment="Center" Checked="RbInterval_Checked"/>
                                <TextBox x:Name="TxtIntervalMinutes" Width="50" Style="{StaticResource InputStyle}" Text="30" Margin="8,0" IsEnabled="False"/>
                                <TextBlock Text="分钟" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TxtFixedTimeHint" Text="每小时的指定分钟数进行数据检查，如：0,30 表示0分和30分时检查" Foreground="#1890FF" FontSize="11" Margin="128,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 推送目标配置 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="推送目标配置" FontSize="15" FontWeight="Bold" Foreground="#333" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="推送终端:" Style="{StaticResource LabelStyle}"/>
                            <ItemsControl x:Name="TerminalCheckBoxes" Grid.Row="1" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="推送方式:" Style="{StaticResource LabelStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <CheckBox x:Name="ChkEnableText" Content="文本消息" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <CheckBox x:Name="ChkEnableImage" Content="图片消息" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 触发条件配置 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="触发条件配置" FontSize="15" FontWeight="Bold" Foreground="#333" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkRealTimeStopPriceDiffRate" Content="realTimeStopPriceDiffRate" VerticalAlignment="Center" FontSize="13" IsChecked="True"/>
                            <TextBlock Grid.Column="1" Text=" &gt; " VerticalAlignment="Center" FontSize="13"/>
                            <TextBox x:Name="TxtRealTimeStopValue" Grid.Column="2" Style="{StaticResource InputStyle}" Text="0" VerticalAlignment="Center" FontSize="13"/>
                        </Grid>
                        <TextBlock Text="（例如：输入5代表5%，对应API返回的0.05）" Foreground="#999" FontSize="11" Margin="24,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkRemainingRisk" Content="remainingRisk" VerticalAlignment="Center" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text=" &lt;= " VerticalAlignment="Center" FontSize="13"/>
                            <TextBox x:Name="TxtRemainingRiskValue" Grid.Column="2" Style="{StaticResource InputStyle}" Text="0" VerticalAlignment="Center" FontSize="13"/>
                        </Grid>
                        <TextBlock Text="（例如：输入5代表5%，对应API返回的0.05）" Foreground="#999" FontSize="11" Margin="24,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnSaveConfig" Content="保存配置" Style="{StaticResource PrimaryButton}" Click="BtnSaveConfig_Click" Margin="0,0,12,0"/>
                    <Button x:Name="BtnTestApi" Content="测试API连接" Style="{StaticResource SecondaryButton}" Background="#722ED1" Click="BtnTestApi_Click" Margin="0,0,12,0"/>
                    <Button x:Name="BtnCheckNow" Content="立即检查" Style="{StaticResource SecondaryButton}" Background="#FA8C16" Click="BtnCheckNow_Click" Margin="0,0,12,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnStartMonitor" Content="启动监控" Style="{StaticResource SecondaryButton}" Click="BtnStartMonitor_Click" Margin="0,0,12,0"/>
                    <Button x:Name="BtnStopMonitor" Content="停止监控" Style="{StaticResource DangerButton}" IsEnabled="False" Click="BtnStopMonitor_Click" Margin="0,0,12,0"/>
                    <Button x:Name="BtnClose" Content="关闭窗口" Style="{StaticResource GrayButton}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
